 "COGNITIVE_DISTORTIONS": {
  "Black-White Thinking": {
   "desc": "All-or-nothing; no middle ground recognised",
   "patterns": [
    "\\b(always|never|every time|all the time|nothing|everything|nobody|everybody|completely|totally|absolutely|100%|zero)\\b",
    "\\b(perfect|perfectly|not once|without exception|no exception)"
   ],
   "ref": "Burns (1980)"
  },
  "Catastrophising": {
   "desc": "Treating a setback as total, permanent catastrophe",
   "patterns": [
    "\\b(ruin|ruined|destroyed|end of|never recover|catastroph|worst.*(ever|always)|everything.*fall)",
    "\\b(disaster|unbearable|devastat|collapse|shatter|fall apart|fall to pieces)"
   ],
   "ref": "Beck (1979)"
  },
  "Emotional Reasoning": {
   "desc": "Treating feelings as objective facts about reality",
   "patterns": [
    "\\b(feel (like|that).*(must|is|are|am)|feels? true|feels? real|feelings? tell me|gut says|i just know|instinct says)",
    "\\b(feel (worthless|stupid|ugly|bad|terrible|awful).*(so|therefore|means|must be))"
   ],
   "ref": "Clark & Beck (2010)"
  },
  "Fortune Telling": {
   "desc": "Predicting negative outcomes as inevitable",
   "patterns": [
    "\\b(will never|won't ever|never going to|it.s over|no point|there.s no|can.t change|won.t change|will always be|nothing will)",
    "\\b(doomed|inevitable|certain to|bound to fail|destined)"
   ],
   "ref": "Clark & Beck (2010)"
  },
  "Jumping to Conclusions": {
   "desc": "Reaching negative conclusions with insufficient evidence",
   "patterns": [
    "\\b(obvious|clearly|obviously|it.s clear|evidently|without a doubt|no doubt|definitely|certainly|must be|has to be|can only mean)",
    "\\b(what else could|there.s only one|the only explanation|plain as day|anyone can see)"
   ],
   "ref": "Clark & Beck (2010)"
  },
  "Labelling": {
   "desc": "Attaching fixed global labels to self or others",
   "patterns": [
    "\\b(i am (a )?(loser|failure|idiot|stupid|worthless|pathetic|weak|coward|terrible person|bad person|monster|fraud|fake))",
    "\\b(he is|she is|they are).{0,20}(terrible|awful|monster|toxic|narcissist|abuser|manipulat)"
   ],
   "ref": "Burns (1980)"
  },
  "Magnification / Minimisation": {
   "desc": "Exaggerating flaws or minimising achievements",
   "patterns": [
    "\\b(huge|massive|enormous|gigantic|terrible|major).{0,20}(mistake|problem|flaw|error|issue)",
    "\\b(just a|only a|merely a|tiny|small|little|nothing really|not a big deal|doesn.t matter)"
   ],
   "ref": "Beck (1979)"
  },
  "Mental Filter": {
   "desc": "Focusing exclusively on negatives, filtering out positives",
   "patterns": [
    "\\b(despite|even though|but still|yet still|nevertheless.*bad|no matter (what|how)|regardless.*negative)",
    "\\b(yes but|sure but|granted but|i know but|i get it but)"
   ],
   "ref": "Beck (1979)"
  },
  "Mind Reading": {
   "desc": "Assuming knowledge of another's thoughts without evidence",
   "patterns": [
    "\\b(knows?|knew) (i |me |my |what i|how i|that i)",
    "\\b(they think|she thinks|he thinks|must think|probably think|obviously think|clearly think|assume.*feel|assume.*know)"
   ],
   "ref": "Beck (1979)"
  },
  "Overgeneralisation": {
   "desc": "Drawing broad conclusions from a single event",
   "patterns": [
    "\\b(always happens|keeps happening|every time|pattern|again and again|time after time|once more|once again|yet again|typical|typical of)",
    "\\b(never works|never changes|nothing ever|always the same)"
   ],
   "ref": "Burns (1980)"
  },
  "Personalisation": {
   "desc": "Assuming excessive personal responsibility for external events",
   "patterns": [
    "\\b(my fault|because of me|i caused|i made (him|her|them)|i ruined|i destroyed|i broke|i am responsible|blame myself|all my fault)",
    "\\b(if only i|i should have|i could have|had i not)"
   ],
   "ref": "Burns (1980)"
  },
  "Should Statements": {
   "desc": "Rigid internal rules creating guilt, shame or resentment",
   "patterns": [
    "\\b(should|shouldn.t|must|mustn.t|have to|ought to|supposed to|expected to|need to be|need to have)\\b",
    "\\b(shouldn.t have|should have|must have|ought to have)"
   ],
   "ref": "Burns (1980)"
  }
 },
